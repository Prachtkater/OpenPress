{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["bun-types"],
    "paths": {
      "@openpress/schemas": ["./packages/schemas/src"],
      "@openpress/core": ["./packages/core/src"],
      "@openpress/ui": ["./packages/ui/src"],
      "@openpress/poc-storage": ["./packages/poc-storage/src"],
      "@openpress/theme-tailwind-plus": ["./packages/theme-tailwind-plus/src"],
      "@openpress/theme-material-expressive": ["./packages/theme-material-expressive/src"],
      "@openpress/feature-contact-form": ["./packages/feature-contact-form/src"],
      "@openpress/feature-booking": ["./packages/feature-booking/src"],
      "@openpress/feature-gallery": ["./packages/feature-gallery/src"],
      "@openpress/feature-media": ["./packages/feature-media/src"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".nuxt",
    ".output",
    "packages/*/src/runtime/server/**",
    "packages/*/src/runtime/plugins/**",
    "packages/*/src/runtime/composables/**",
    "packages/*/src/runtime/pages/**",
    "packages/*/src/runtime/components/**"
  ]
}
