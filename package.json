{
  "name": "openpress",
  "private": true,
  "version": "0.0.0",
  "description": "OpenPress - Nuxt-native Visual CMS with Git-backed Storage",
  "workspaces": [
    "packages/*",
    "playground",
    "schemas"
  ],
  "scripts": {
    "dev": "bun run --filter './playground' dev",
    "build": "bun run --filter './packages/*' build",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
