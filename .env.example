# ── OpenPress Environment Configuration ──────────────────────

# Server
HOST=0.0.0.0
PORT=3000

# OpenPress Core
NUXT_OPENPRESS_CONTENT_DIR=./content
NUXT_OPENPRESS_EDIT_PATH=/_edit
NUXT_OPENPRESS_AUTO_COMMIT=true

# Contact Form Feature
NUXT_OP_CONTACT_FORM_SMTP_HOST=localhost
NUXT_OP_CONTACT_FORM_SMTP_PORT=587
NUXT_OP_CONTACT_FORM_NOTIFY_TO=admin@example.com
NUXT_OP_CONTACT_FORM_FROM=noreply@example.com

# Git Storage
GIT_AUTHOR_NAME=OpenPress
GIT_AUTHOR_EMAIL=openpress@example.com
