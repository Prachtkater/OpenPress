{
  "name": "openpress",
  "private": true,
  "version": "0.0.0",
  "description": "OpenPress - Nuxt-native Visual CMS with Git-backed Storage",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "bun run --filter '@openpress/playground' dev",
    "build": "bun run --filter '@openpress/*' build",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "health-check": "bun run scripts/health-check.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "lefthook": "^2.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
